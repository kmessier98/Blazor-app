@page "/livre/{Id:int}"

<PageTitle>Livre infos - LibraryApp</PageTitle>

@if (_isLoading)
{
    <div class="loading-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
}

@if (_livre != null)
{
    <div class="content">
        <h3>Infos livre</h3>

        <span class="title">@_livre.Titre</span><br />
        <span class="author-row">par
            <a href="/auteur/@_livre.AuteurId" class="author-link text-decoration-none">
                @_livre.PrenomAuteur @_livre.NomAuteur
            </a>
            · @_livre.NomEditeur
        </span><br />
        <div class="categories">
            @foreach (var category in _livre.Categories)
            {
                <span class="badge rounded-pill custom-badge-color px-3 py-2">@category.Nom</span>
            }
        </div>
        <hr />

        <div class="user-select">
            <span>Membre</span>
            <select class="form-select" @bind="_selectedMembreId">
                @foreach (var membre in _membres!)
                {
                    <option value="@membre.Id">@membre.Nom</option>
                }
            </select>
        </div>

        <hr />

        <div class="exemplaire-container">
            <span>Exemplaires <span class="text-success">(@_livre.Exemplaires.Count(x => x.EstDisponible) / @_livre.Exemplaires.Count disponibles)</span></span>
            <div class="exemplaires">
                @foreach(var exemplaire in _livre.Exemplaires)
                {
                    <div class="exemplaire-row">
                        <span>@exemplaire.CodeBarre</span>
                           @if (exemplaire.EstDisponible)
                            {
                                <span class="text-success">Disponible</span>
                                <button type="button" class="btn btn-light border border-secondary-subtle rounded-3 px-4 py-2 text-primary-emphasis">
                                    Emprunter
                                </button>
                            }
                            else
                            {
                                var nomEmprunteur = exemplaire.Emprunts
                                    .FirstOrDefault(x => x.DateRetour == null)?.NomMembre;

                                <span class="text-danger">Emprunté par @nomEmprunteur</span>
                                <button type="button" class="btn border rounded-3 px-4 py-2 disabled">Emprunter</button>
                            }
                    </div>
                    
                    if (!exemplaire.Equals(_livre.Exemplaires.Last()))
                    {
                        <hr />
                    }
                }

                <span class="text-danger avertissement">⚠ NOM a déjà l'exemplaire ... de ce livre -- tous les autres boutons Emprunter pour elle sont désactivés</span>
            </div>
        </div>

        <div class="history">
            <span class="history-title">Historique des emprunts</span>
            <div class="table-reponsive w-100">
                <table class="table align-middle custom-table">
                    <!-- Entête du tableau -->
                    <thead>
                        <tr>
                            <th scope="col" class="col-user">Exemplaire</th>
                            <th scope="col" class="col-user">Utilisateur</th>
                            <th scope="col" class="col-emprunt-date">Emprunté le</th>
                            <th scope="col" class="retour-date text-end">Retourné le</th>
                        </tr>
                    </thead>

                    <!-- Corps du tableau -->
                    <tbody>
                        @foreach (var exemplaire in _livre.Exemplaires)
                        {
                            @foreach (var emprunt in exemplaire.Emprunts)
                            {
                                <tr>
                                    <td>@exemplaire.CodeBarre</td>
                                    <td>@emprunt.NomMembre</td>
                                    <td>@emprunt.DateEmprunt.ToString("d MMMM yyyy HH:mm:ss")</td>
                                    @if (emprunt.DateRetour != null)
                                    {
                                        <td class="text-end">@emprunt.DateRetour?.ToString("d MMMM yyyy HH:mm:ss")</td>
                                    }
                                    else
                                    {
                                        <td class="text-end text-en-cours-emprunt">En cours d'emprunt</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (_isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">Emprunter</h1>
                    <button type="button" class="btn-close" @onclick="(() => { _isModalOpen = false; _modalSelectedMembreId = 1; })"></button>
                </div>
                <div class="modal-body">
                    <h4>Sélectionner un membre:</h4>
                    <div class="membres-list-filter">
                        <select class="form-select" @bind="_modalSelectedMembreId">
                            @foreach (var membre in _membres!)
                            {
                                <option value="@membre.Id">@membre.Nom</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="(() => { _isModalOpen = false; _modalSelectedMembreId = 1; })">Annuler</button>
                    <button type="button" class="btn btn-primary" @onclick="() => Emprunter()">Emprunter</button>
                </div>
            </div>
        </div>
    </div>
}
