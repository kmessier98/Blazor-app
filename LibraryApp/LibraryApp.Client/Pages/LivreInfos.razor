@page "/livre/{Id:int}"

<PageTitle>Livre infos - LibraryApp</PageTitle>

@if (_isLoading)
{
    <div class="loading-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
}

@if (_livre != null)
{
    <div class="content">
        <h3>Infos livre</h3>

        <span class="title">@_livre.Titre</span><br />
        <span class="author-row">par
            <a href="/auteur/@_livre.AuteurId" class="author-link text-decoration-none">
                @_livre.PrenomAuteur @_livre.NomAuteur
            </a>
            · @_livre.NomEditeur
        </span><br />
        <div class="categories">
            @foreach (var category in _livre.Categories)
            {
                <span class="badge rounded-pill custom-badge-color px-3 py-2">@category.Nom</span>
            }
        </div>
        <hr />

        <div class="disponible-row">
            @if (_livre.EstDisponible)
            {
                <div><span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">Disponible</span></div>
                <button class="btn-emprunter" @onclick="(() => { _isModalOpen = true; })">Emprunter</button>
            }
            else
            {
                <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">Emprunté</span>
            }
        </div>

        <div class="history">
            <span class="history-title">Historique des emprunts</span>
            <div class="table-reponsive w-100">
                <table class="table align-middle custom-table">
                    <!-- Entête du tableau -->
                    <thead>
                        <tr>
                            <th scope="col" class="col-user">Utilisateur</th>
                            <th scope="col" class="col-emprunt-date">Emprunté le</th>
                            <th scope="col" class="retour-date text-end">Retourné le</th>
                        </tr>
                    </thead>

                    <!-- Corps du tableau -->
                    <tbody>
                        @foreach (var emprunt in _livre.Emprunts)
                        {
                            <tr>
                                <td>@emprunt.NomUtilisateur</td>
                                <td>@emprunt.DateEmprunt.ToString("d MMMM yyyy HH:mm:ss")</td>
                                @if (emprunt.DateRetour != null)
                                {
                                    <td class="text-end">@emprunt.DateRetour?.ToString("d MMMM yyyy HH:mm:ss")</td>
                                }
                                else
                                {
                                    <td class="text-end">En cours d'emprunt</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (_isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">Emprunter</h1>
                    <button type="button" class="btn-close" @onclick="(() => { _isModalOpen = false; _selectedUserId = 1; })"></button>
                </div>
                <div class="modal-body">
                    <h4>Sélectionner un utilisateur:</h4>
                    <div class="utilisateurs-list-filter">
                        <select class="form-select" @bind="_selectedUserId">
                            @foreach (var utilisateur in _utilisateurs!)
                            {
                                <option value="@utilisateur.Id">@utilisateur.Nom</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="(() => { _isModalOpen = false; _selectedUserId = 1; })">Annuler</button>
                    <button type="button" class="btn btn-primary" @onclick="() => Emprunter()">Emprunter</button>
                </div>
            </div>
        </div>
    </div>
}
