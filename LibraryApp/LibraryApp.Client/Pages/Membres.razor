@page "/Membres"

@if (_isLoading)
{
    <div class="loading-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
}

<div class="content">
    <h3>Membres</h3>
    <div class="filter-container">
        <div class="search-container">
            <input type="text"
                   @bind-value="_searchQuery"
                   @bind-value:event="oninput"
                   placeholder="Rechercher un membre..."
                   class="form-control" />
        </div>
        <div class="new-membre-btn">
            <button type="button"
                    class="btn btn-light border text-dark px-4 py-2"
                    @onclick="(() => { _isModalOpen = true; _newMembre = new(); })">+ Nouveau membre</button>
        </div>
    </div>

    <div class="membres-container">
        @if (!FilteredItems.Any())
        {
            <div class="alert alert-info">Aucun membre ne correspond à vos critères.</div>
        }
        else
        {
            <div class="list-membre">
                @foreach (var membre in FilteredItems)
                {
                    var aDesEmpruntsActifs = membre.NombreEmprunt > 0;

                    <div class="membre">
                        <div class="left">
                            <span class="membre-name">@membre.Nom</span>
                            <span class="membre-courriel">@membre.Courriel</span>
                        </div>
                        <div class="right">
                            <span class="nbr-emprunt">
                                @membre.NombreEmprunt @(membre.NombreEmprunt > 1 ? "emprunts actifs" : "emprunt actif")
                            </span>
                            <button class="btn-icon-supprimer"
                                    disabled="@aDesEmpruntsActifs" 
                                    title="@(aDesEmpruntsActifs ? "Impossible de supprimer un membre avec un emprunt actif" : "Supprimer")"
                                    @onclick="(async () => { _isDeleteConfirmationOpen = true; _membreToDelete = membre; } )">
                                <span class="bi bi-trash"></span>
                            </button>                           
                        </div>
                    </div>

                    @if (!membre.Equals(FilteredItems.Last()))
                    {
                        <hr />
                    }
                }           
            </div>
        }
    </div>
</div>


@if (_isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">Emprunter</h1>
                    <button type="button" class="btn-close" @onclick="(() => { ClearModal(); })"></button>
                </div>
                <div class="modal-body">
                    @*TODO utiliser EditForm pour gérer les erreurs clients*@
                    <div class="form">
                        <div class="element">
                           <label for="nom-membre">Nom complet</label>
                            <input type="text" id="nom-membre" placeholder="Ex: Sophie Gagnon" @bind-value="_newMembre!.Nom" @bind-value:event="oninput" />
                        </div>
                        <div class="element">
                            <label for="courriel-membre" >Courriel</label>
                            <input type="email" id="courriel-membre" placeholder="Ex: sophie.gagnon@example.com" @bind-value="_newMembre.Courriel" @bind-value:event="oninput" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div>
                    @if (_validationErrors.Count > 0)
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in _validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn-secondary" @onclick="(() => { ClearModal(); })">Annuler</button>
                        <button type="button" class="btn btn-new-membre" @onclick="() => CreateNewMembre()">Créer le membre</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_isDeleteConfirmationOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">Supprimer</h1>
                    <button type="button" class="btn-close" @onclick="(() => { ClearDeleteConfirmationModal(); })"></button>
                </div>
                <div class="modal-body">
                    <h4>Supprimer ce membre?</h4>
                    <p>@_membreToDelete.Nom sera retiré définitivement. Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <div class="actions">
                        <button type="button" class="btn btn-secondary" @onclick="(() => { ClearDeleteConfirmationModal(); })">Annuler</button>
                        <button type="button" class="btn btn-delete-membre" @onclick="() => DeleteMembre()">Supprimer</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
